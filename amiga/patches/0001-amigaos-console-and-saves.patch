 void LoadScreen::ChangeDir(const std::filesystem::path &new_path) {
     current_index = 0;
+#ifdef __amigaos__
+    // AmigaOS names (Work:Games/ProgressQuest2/User) are not POSIX paths, so
+    // the C++ library cannot go up from them or make them absolute: the
+    // saved games are listed from the current directory, the User drawer
+    // the game starts in (amiga/amiga_start.cpp), with no other drawers.
+    (void) new_path;
+    path = ".";
+    files.clear();
+    for (auto &entry: std::filesystem::directory_iterator(path)) {
+        if (!entry.is_directory() && entry.path().extension() == ".pq2") {
+            files.push_back(entry.path().filename());
+        }
+    }
+    std::sort(files.begin(), files.end());
+    return;
+#endif
     if (new_path == "..") {
         path = path.parent_path();
     }
