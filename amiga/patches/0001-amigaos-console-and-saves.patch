diff --git a/ncurses/gamescreen.cpp b/ncurses/gamescreen.cpp
index 3d97737..29344cc 100644
--- a/ncurses/gamescreen.cpp
+++ b/ncurses/gamescreen.cpp
@@ -21,9 +21,20 @@ void GameScreen::ShowProgress(const int line, const T progress_current, const T
     const float progress = base_progress * max_progress;
     const int full_progress = static_cast<int>(progress / characters.size());
     const int remaining_progress = static_cast<int>(progress) % static_cast<int>(characters.size());
+#ifdef __amigaos__
+    // the Amiga console's fonts have no block characters: the bar is drawn
+    // in ASCII, a '#' for each full cell and a '+' for one half full or more
+    std::string progress_str(full_progress, '#');
+    if (remaining_progress >= static_cast<int>(characters.size()) / 2) {
+        progress_str += '+';
+    }
+    mvwaddch(win, line, LEFT, '|');
+    mvwprintw(win, line, LEFT, "%s", progress_str.c_str());
+#else
     const auto progress_str = std::wstring(full_progress, 0x2588) + characters[remaining_progress];
     mvwprintw(win, line, LEFT, "%lc", 0x258F);
     mvwprintw(win, line, LEFT, "%ls", progress_str.c_str());
+#endif
     if (show_progress_labels) {
         CenterAlign(win, std::to_string(static_cast<int>(std::round(base_progress * 100))) + "%", 40, line);
     }
