 void NCursesView::Update() {
+#ifdef __amigaos__
+    // wclear also clears the whole console window before the next refresh:
+    // ten times a second, it flickers. werase leaves the drawing by
+    // difference to curses.
+    werase(win);
+#else
     wclear(win);
+#endif
     if (screen_width < required_width || screen_height < required_height) {
         wprintw(win, "Progress Quest 2 requires a terminal of at least 80x24");
     }
