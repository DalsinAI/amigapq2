 Game::Game(): character() {
+#if defined(__amigaos__)
+    // no random device on the Amiga: seed from the clock and the heap
+    const uint64_t seed = static_cast<uint64_t>(chrono::steady_clock::now().time_since_epoch().count())
+        ^ (static_cast<uint64_t>(time(nullptr)) << 20) ^ reinterpret_cast<uintptr_t>(this);
+    engine = make_shared<mt19937_64>(seed);
+#else
     random_device random;
     engine = make_shared<mt19937_64>(random());
+#endif
     game_state = GameStateNone;
 }
 
